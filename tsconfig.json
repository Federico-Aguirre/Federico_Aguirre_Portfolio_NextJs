{
  "compilerOptions": {
    "target": "ES2022",
    "baseUrl": "src",
    "paths": {
      "@/*": [
        "*"
      ],
      "@/store/*": [
        "app/store/*"
      ],
      "@/svg/*": [
        "../public/svg/*"
      ],
      "@/particlejsConfig/*": [
        "app/components/(particlejsConfig)/*"
      ],
      "@/assets/*": [
        "assets/*"
      ]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
